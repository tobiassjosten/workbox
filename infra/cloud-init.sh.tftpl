#!/usr/bin/env bash
# workbox VM bootstrap (Compute Engine startup-script). Runs as root on boot and
# is idempotent: re-running it converges rather than duplicating work. User-level
# tooling (Claude Code, Herdr) is installed as the development user, not root.
#
# Terraform fills in its interpolations; shell expansions use the doubled-dollar
# form (or no braces) so templatefile leaves them intact.
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive

LINUX_USER="${linux_user}"
DATA_DEV="/dev/disk/by-id/google-${data_device_name}"
DATA_MOUNT="${data_mount}"
LOG() { echo "[workbox-bootstrap] $*"; }

LOG "timezone"
timedatectl set-timezone "${timezone}" || true

LOG "base packages"
apt-get update -y
apt-get install -y \
  git curl ca-certificates build-essential jq ripgrep tmux unzip gnupg lsb-release

# --- Persistent development disk -------------------------------------------
LOG "development disk"
if [ -b "$${DATA_DEV}" ]; then
  if ! blkid "$${DATA_DEV}" >/dev/null 2>&1; then
    LOG "formatting $${DATA_DEV} (no filesystem found)"
    mkfs.ext4 -m 0 -E lazy_itable_init=0,lazy_journal_init=0 "$${DATA_DEV}"
  fi
  mkdir -p "$${DATA_MOUNT}"
  DATA_UUID="$(blkid -s UUID -o value "$${DATA_DEV}")"
  if ! grep -q "$${DATA_UUID}" /etc/fstab; then
    echo "UUID=$${DATA_UUID} $${DATA_MOUNT} ext4 discard,defaults,nofail 0 2" >> /etc/fstab
  fi
  mount -a
  mkdir -p "$${DATA_MOUNT}/projects" "$${DATA_MOUNT}/docker"
  chown -R "$${LINUX_USER}:$${LINUX_USER}" "$${DATA_MOUNT}"
else
  LOG "WARNING: data device $${DATA_DEV} not present; skipping mount"
fi

# --- Docker (data-root on the development disk) -----------------------------
LOG "docker"
if [ ! -f /etc/docker/daemon.json ]; then
  mkdir -p /etc/docker
  cat > /etc/docker/daemon.json <<JSON
{
  "data-root": "$${DATA_MOUNT}/docker"
}
JSON
fi
if ! command -v docker >/dev/null 2>&1; then
  install -m 0755 -d /etc/apt/keyrings
  curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
  chmod a+r /etc/apt/keyrings/docker.asc
  ARCH="$(dpkg --print-architecture)"
  CODENAME="$(. /etc/os-release && echo "$${VERSION_CODENAME}")"
  echo "deb [arch=$${ARCH} signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $${CODENAME} stable" \
    > /etc/apt/sources.list.d/docker.list
  apt-get update -y
  apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
fi
usermod -aG docker "$${LINUX_USER}" || true
systemctl enable --now docker || true

# --- OpenSSH hardening (key-only) -------------------------------------------
LOG "sshd hardening"
cat > /etc/ssh/sshd_config.d/99-workbox.conf <<'SSHD'
# Managed by workbox bootstrap.
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
ChallengeResponseAuthentication no
PermitRootLogin no
SSHD
# The configured public key is installed by the guest agent from instance
# metadata (ssh-keys); no private key is ever placed on this VM.
systemctl reload ssh 2>/dev/null || systemctl reload sshd 2>/dev/null || true

# --- Tailscale --------------------------------------------------------------
LOG "tailscale"
if ! command -v tailscale >/dev/null 2>&1; then
  CODENAME_TS="$(. /etc/os-release && echo "$${VERSION_CODENAME}")"
  mkdir -p /usr/share/keyrings /etc/apt/sources.list.d
  curl -fsSL "https://pkgs.tailscale.com/stable/ubuntu/$${CODENAME_TS}.noarmor.gpg" \
    | tee /usr/share/keyrings/tailscale-archive-keyring.gpg >/dev/null
  echo "deb [signed-by=/usr/share/keyrings/tailscale-archive-keyring.gpg] https://pkgs.tailscale.com/stable/ubuntu $${CODENAME_TS} main" \
    > /etc/apt/sources.list.d/tailscale.list
  apt-get update -y
  apt-get install -y tailscale
fi
systemctl enable --now tailscaled || true
if ! tailscale status >/dev/null 2>&1; then
  LOG "joining tailnet"
  tailscale up --authkey="${ts_authkey}" --hostname="${ts_hostname}" --ssh=false
fi

# --- Development user tooling (run as the user, not root) --------------------
LOG "user tooling for $${LINUX_USER}"
USER_HOME="$(getent passwd "$${LINUX_USER}" | cut -d: -f6)"
install -d -o "$${LINUX_USER}" -g "$${LINUX_USER}" "$${USER_HOME}/.claude"
# Create .local tree with correct ownership before running user installers.
# install -d only sets ownership on the leaf; parent dirs get root ownership,
# which breaks installers that mkdir siblings (e.g. claude -> .local/share).
install -d -o "$${LINUX_USER}" -g "$${LINUX_USER}" "$${USER_HOME}/.local"
install -d -o "$${LINUX_USER}" -g "$${LINUX_USER}" "$${USER_HOME}/.local/bin"
install -d -o "$${LINUX_USER}" -g "$${LINUX_USER}" "$${USER_HOME}/.local/share"

# Convenience: ~/work -> the projects directory on the persistent disk.
if [ ! -e "$${USER_HOME}/work" ]; then
  ln -s "$${DATA_MOUNT}/projects" "$${USER_HOME}/work"
  chown -h "$${LINUX_USER}:$${LINUX_USER}" "$${USER_HOME}/work"
fi

# Ensure ~/.local/bin is on PATH for interactive shells.
if ! grep -q 'workbox: local bin' "$${USER_HOME}/.bashrc" 2>/dev/null; then
  cat >> "$${USER_HOME}/.bashrc" <<'BASHRC'

# workbox: local bin
export PATH="$HOME/.local/bin:$PATH"
BASHRC
fi

# Forward the local ssh-agent into herdr panes so Git in a pane can authenticate
# to private repos via the forwarded agent. Herdr runs a persistent server
# whose panes inherit a stale environment, so the per-connection forwarded
# socket ($SSH_AUTH_SOCK, a fresh /tmp path per SSH connection) is invisible to
# them. Fix it the standard tmux/screen way: every SSH login relinks a stable
# socket path to the live forwarded agent, and shells adopt that stable path
# while it is live. Only a socket symlink lives on the VM — never any key
# material.
# ~/.ssh normally already exists (the guest agent creates it to install
# `authorized_keys`); create it defensively and re-assert 0700 and dev-user
# ownership each boot so the relink target is always present.
install -d -m 0700 -o "$${LINUX_USER}" -g "$${LINUX_USER}" "$${USER_HOME}/.ssh"
cat > /etc/ssh/sshrc <<'SSHRC'
# Managed by workbox bootstrap (run by sshd via /bin/sh on each login): pin the
# forwarded ssh-agent to a stable path. Last-writer-wins — every login repoints
# the stable path to its own live forwarded socket. This is deliberate: after a
# suspend/resume the previous connection's socket can survive as a socket file
# (its sshd process is restored from RAM) while being dead from the client side,
# so a "claim only when free" guard would pin the stable path to a defunct agent
# and every wake would fail with publickey. Unconditionally relinking lets the
# newest connection take over; panes reach the agent through the stable path, so
# they follow the relink without reopening. The trade-off is that concurrent
# logins steal the link from each other — with more than one forwarding
# connection open the last to log in owns the agent — so keep a single active
# connection. The owning connection must stay attached for agent access; closing
# it leaves a dangling link, which .bashrc's -S test then declines to adopt.
if [ -S "$SSH_AUTH_SOCK" ]; then
  ln -sf "$SSH_AUTH_SOCK" "$HOME/.ssh/ssh_auth_sock"
fi
SSHRC
if ! grep -q 'workbox: forwarded ssh-agent' "$${USER_HOME}/.bashrc" 2>/dev/null; then
  cat >> "$${USER_HOME}/.bashrc" <<'BASHRC'

# workbox: forwarded ssh-agent (stable socket relinked by /etc/ssh/sshrc).
# Adoption piggybacks on ~/.bashrc, like the PATH export above — herdr's panes
# are interactive non-login shells that source it. Adopt the socket only while
# the link is live; a dangling link (no forwarding connection attached) leaves
# SSH_AUTH_SOCK untouched so tools report a missing agent rather than a broken
# one. -S follows the symlink.
[ -S "$HOME/.ssh/ssh_auth_sock" ] && export SSH_AUTH_SOCK="$HOME/.ssh/ssh_auth_sock"
BASHRC
fi

run_as_user() { runuser -l "$${LINUX_USER}" -c "$1"; }

# Claude Code (native installer; no npm). Auth is interactive and done later by
# the user running `claude` — no credentials are provisioned here.
if ! run_as_user 'command -v claude >/dev/null 2>&1 || test -x "$HOME/.local/bin/claude"'; then
  LOG "installing Claude Code"
  run_as_user 'curl -fsSL https://claude.ai/install.sh | bash' || LOG "claude install failed (non-fatal)"
fi

# Herdr (single binary).
if ! run_as_user 'command -v herdr >/dev/null 2>&1 || test -x "$HOME/.local/bin/herdr"'; then
  LOG "installing Herdr"
  run_as_user 'curl -fsSL https://herdr.dev/install.sh | bash' || LOG "herdr install failed (non-fatal)"
fi

# Herdr <-> Claude integration hook.
run_as_user 'export PATH="$HOME/.local/bin:$PATH"; command -v herdr >/dev/null 2>&1 && herdr integration install claude' \
  || LOG "herdr integration install skipped (non-fatal)"

LOG "bootstrap complete"
