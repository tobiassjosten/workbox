# Environment variables needed to run Terraform for workbox.
#
# Copy to .env.local (git-ignored) and fill in real values, then load it before
# any Terraform command:
#   cp .env.example .env.local && $EDITOR .env.local
#   . ./.env.local                        # every line already exports
#
# GCP auth is separate — it uses Application Default Credentials, not an env var:
#   gcloud auth application-default login

# Tailscale OAuth client for the tailscale Terraform provider. The client needs
# the auth_keys (write) scope with your tailscale.tag attached (defaults to
# tag:<name>, e.g. tag:workbox); add policy-file (write) only if
# tailscale.manage_policy = true. See infra/providers.tf.
export TAILSCALE_OAUTH_CLIENT_ID=xxxxxxxxxxxxxxxx
export TAILSCALE_OAUTH_CLIENT_SECRET=tskey-client-xxxxxxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: pin the tailnet the OAuth client acts on (usually inferred).
# export TAILSCALE_TAILNET=example.com
